if [ $WARM_START = .false. ]; then
  mkdir INPUT RESTART

  cp -r /scratch1/NCEPDEV/swpc/Svetlana.Karol/save/FV3WAM_C96_L196/INPUT_20230101/* ./INPUT/.
 cp @(INPUTDATA_ROOT)/* ./
 cp  /scratch3/NCEPDEV/swpc/Svetlana.Karol/SWD_2023/solar_kpf107_3min.nc ./
else
  mkdir INPUT RESTART
  CURRDIR=`pwd`
  FILEDIR=${CURRDIR}/../${DEP_RUN}
  cp -r ${FILEDIR}/RESTART/* ./INPUT
  cp ${FILEDIR}/INPUT/grid_spec.nc INPUT/.
  cp ${FILEDIR}/INPUT/*_grid.tile*.nc INPUT/.
  cp ${FILEDIR}/INPUT/oro_data*.nc INPUT/.
  cp ${INPUTDATA_COLD}/*{grb,f77,dat,txt,BIN} .
fi
